{
  "name": "dotto",
  "version": "0.1.0",
  "packageManager": "pnpm@12.15.0",
  "private": true,
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "biome check",
    "fix": "biome check --write",
    "ci-check": "biome ci .",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "preview:storybook": "wrangler pages dev storybook-static",
